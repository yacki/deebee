# Docker 对外监听；默认只允许当前主机访问。
DEEBEE_BIND_ADDRESS=127.0.0.1
DEEBEE_PORT=3000

# 访问前缀；例如 https://example.com/deebee/。设为 / 可部署在网站根路径。
DEEBEE_BASE_PATH=/deebee

# 所有已保存连接和加密密钥都会写入这个宿主机目录。
DEEBEE_DATA_DIR=./data

DEEBEE_ADMIN_USER=admin
DEEBEE_ADMIN_PASSWORD=replace-with-a-strong-password
DEEBEE_IMAGE_TAG=latest

# 通常无需设置；留空时 DeeBee 会在 data 目录生成持久化随机密钥。
# DEEBEE_TOKEN_SECRET=replace-with-a-long-random-value

# 新部署默认不创建示例数据库连接，请登录后在界面中添加。
DEEBEE_MYSQL_ENABLED=false
DEEBEE_POSTGRES_ENABLED=false
