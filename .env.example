# Docker 对外监听；默认只允许当前主机访问。
DEEBEE_BIND_ADDRESS=127.0.0.1
DEEBEE_PORT=3000

# 访问前缀；例如 https://example.com/deebee/。设为 / 可部署在网站根路径。
DEEBEE_BASE_PATH=/deebee

# 所有已保存连接和加密密钥都会写入这个宿主机目录。
DEEBEE_DATA_DIR=./data

DEEBEE_ADMIN_USER=admin
DEEBEE_ADMIN_PASSWORD=replace-with-a-strong-password
DEEBEE_IMAGE_TAG=latest

# 通常无需设置；留空时 DeeBee 会在 data 目录生成持久化随机密钥。
# DEEBEE_TOKEN_SECRET=replace-with-a-long-random-value

# 新部署默认不创建示例数据库连接，请登录后在界面中添加。
DEEBEE_MYSQL_ENABLED=false
DEEBEE_POSTGRES_ENABLED=false

# 身份与访问 V1；保留原工作台入口。固定公开 URL 必须包含部署前缀。
# 外部 MCP / OIDC 浏览器登录的生产部署请设置这一项。
# DEEBEE_PUBLIC_URL=https://example.com/deebee
# 默认保存到 connections.json 同目录下的 access-v1；必须持久化并保护其密钥。
# DEEBEE_ACCESS_DIR=/app/data/access-v1
# 仅经部署管理员批准的内网 IdP 使用；仍要求 HTTPS，不允许链路本地地址。
# DEEBEE_ACCESS_ALLOW_PRIVATE_IDP=1
# DEEBEE_ACCESS_ALLOW_INSECURE_LOCAL 仅供隔离实验室，生产环境不得启用。
# 仅在客户端不能自定义 X-DeeBee-API-Key 时启用；允许把 dbk_ Key 放入 Authorization: Bearer。
# DEEBEE_ACCESS_ALLOW_MANAGED_KEY_BEARER=1
# 0 表示审计事件长期保留；设置正整数时按天清理。请求/响应审计摘要固定各最多 1 KiB。
DEEBEE_AUDIT_RETENTION_DAYS=0
