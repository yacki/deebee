DEEBEE_ADMIN_USER=admin
DEEBEE_ADMIN_PASSWORD=change-me
DEEBEE_TOKEN_SECRET=replace-with-a-long-random-value
# 可选；默认保存到 backend/data/connections.json（Docker 中为 /app/data/connections.json）
# DEEBEE_CONNECTIONS_FILE=/absolute/path/to/connections.json
DEEBEE_MYSQL_NAME=MySQL Development
DEEBEE_MYSQL_HOST=127.0.0.1
DEEBEE_MYSQL_PORT=3306
DEEBEE_MYSQL_USER=root
DEEBEE_MYSQL_PASSWORD=
DEEBEE_MYSQL_DATABASE=
DEEBEE_MYSQL_ENABLED=true
DEEBEE_POSTGRES_ENABLED=false
DEEBEE_POSTGRES_NAME=PostgreSQL Development
DEEBEE_POSTGRES_HOST=127.0.0.1
DEEBEE_POSTGRES_PORT=5432
DEEBEE_POSTGRES_USER=postgres
DEEBEE_POSTGRES_PASSWORD=
DEEBEE_POSTGRES_DATABASE=postgres
DEEBEE_POSTGRES_SCHEMA=public
DEEBEE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
