{
  "name": "deebee-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:backend": "backend/.venv/bin/pytest -q backend/tests",
    "test:all": "npm run test:backend && npm test && npm run test:e2e",
    "lint": "eslint src vite.config.ts tests/e2e"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@iconify/vue": "^5.0.1",
    "@types/guacamole-common-js": "^1.5.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "guacamole-common-js": "^1.5.0",
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@openai/sites-vite-plugin": "0.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "16.4.0",
    "sql-formatter": "^15.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.10"
  },
  "overrides": {
    "dompurify": "3.4.14"
  },
  "type": "module"
}
